# ──────────────────────────────────────────────
# Copy this file to .env and fill in real values
# NEVER commit .env to git
# ──────────────────────────────────────────────

# Neon PostgreSQL connection string
# Get it from: https://console.neon.tech → your project → Dashboard → Connection string
DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# AeroDataBox (RapidAPI) — for real flight lookups
AERODATABOX_API_KEY=your_rapidapi_key_here

# Notion integration token — for beta feedback
NOTION_TOKEN=secret_xxxx

# Express server port (optional, defaults to 5000)
PORT=5000


# Backend API base URL (optional — defaults to http://localhost:5000 in dev)
# EXPO_PUBLIC_API_URL=https://your-production-server.com

# Apple Wallet / PassKit identity
# Required for the "Add to Wallet" feature. Without these the app will show
# a clear error when a user tries to generate a boarding pass.
#
# EXPO_PUBLIC_PASSKIT_TEAM_ID:
#   Your 10-character Apple Team ID.
#   Find it at: developer.apple.com → account name (top-right corner)
#   Example: AB12CD34EF
#
# EXPO_PUBLIC_PASSKIT_PASS_TYPE_ID:
#   The Pass Type ID you registered at:
#   developer.apple.com → Certificates, Identifiers & Profiles → Identifiers → Pass Type IDs
#   Recommended value: pass.com.logbookapp.boardingpass
#
# For EAS builds, set both via:
#   eas env:create --scope project --name EXPO_PUBLIC_PASSKIT_TEAM_ID --value YOUR_TEAM_ID
#   eas env:create --scope project --name EXPO_PUBLIC_PASSKIT_PASS_TYPE_ID --value pass.com.logbookapp.boardingpass
EXPO_PUBLIC_PASSKIT_TEAM_ID=YOUR_10_CHAR_TEAM_ID
EXPO_PUBLIC_PASSKIT_PASS_TYPE_ID=pass.com.logbookapp.boardingpass

# Server authentication
# Required for signed server sessions. Use a long random secret and never commit the real value.
SESSION_SECRET=
# Development only. Do not enable in production.
ALLOW_TEST_AUTH=false
