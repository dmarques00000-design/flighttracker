# .env.local.example
# Copy this file to .env.local and fill in your real values.
# .env.local is git-ignored and must NEVER be committed.
#
# For EAS cloud builds, store secrets with:
#   eas secret:create --scope project --name <NAME> --value <value> --environment production
# (repeat for each variable below that has an EAS column marked YES)
#
# Variable                   | Required for     | EAS secret? | Notes
# ---------------------------|------------------|-------------|-------------------------------
# APPLE_TEAM_ID              | iOS builds       | YES         | 10-char uppercase alphanumeric
# SHOW_TEST_ACCOUNT          | dev/preview only | no          | set to "true" to show banner
# EXPO_PUBLIC_IS_BETA        | dev/preview only | no          | set to "true" for beta UI

# Your Apple Developer Team ID (10 uppercase alphanumeric chars, e.g. AB12CD34EF)
# Find it at: https://developer.apple.com/account → Membership → Team ID
APPLE_TEAM_ID=


# Show the test-account banner in the UI (development / preview builds only)
# SHOW_TEST_ACCOUNT=true

# Enable beta-specific UI flags
# EXPO_PUBLIC_IS_BETA=true

# Server authentication
SESSION_SECRET=
ALLOW_TEST_AUTH=true
