<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Group shared with the main Logbook app.
	     Must match APP_GROUP in app.config.js and utils/widgetData.ts -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.logbookapp.shared</string>
	</array>
</dict>
</plist>
