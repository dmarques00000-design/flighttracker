{
  "cli": {
    "version": ">= 18.4.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "channel": "development",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "SHOW_TEST_ACCOUNT": "true",
        "EXPO_PUBLIC_IS_BETA": "true"
      },
      "ios": {
        "image": "latest",
        "cache": {
          "disabled": false,
          "key": "cocoapods-v1"
        }
      },
      "node": "20.18.0"
    },
    "preview": {
      "channel": "preview",
      "distribution": "internal",
      "env": {
        "SHOW_TEST_ACCOUNT": "true",
        "EXPO_PUBLIC_IS_BETA": "true"
      },
      "ios": {
        "image": "latest"
      },
      "node": "20.18.0"
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "credentialsSource": "remote",
      "ios": {
        "image": "latest"
      },
      "node": "20.18.0"
    }
  },
  "submit": {
    "production": {}
  }
}
