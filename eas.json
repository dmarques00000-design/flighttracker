{
  "cli": {
    "version": ">= 18.4.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "image": "latest",
        "cache": {
          "disabled": false,
          "key": "cocoapods-v1"
        }
      },
      "node": "20.18.0"
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "image": "latest"
      },
      "node": "20.18.0"
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "image": "latest"
      },
      "node": "20.18.0"
    }
  },
  "submit": {
    "production": {}
  }
}
